# Copy to .env, next to compose.yaml. `docker compose` reads it. Never commit real values.

# The Claude login for the llm-proxy container, from `claude setup-token`. Secret.
# Only the proxy sees it. Without it the map and alerts work and the chat does not.
CLAUDE_CODE_OAUTH_TOKEN=

# The NASA FIRMS archive key, free from https://firms.modaps.eosdis.nasa.gov/api/map_key/. Secret.
# Only the one-off history job reads it. Without it everything else still runs.
FIRMS_MAP_KEY=

# The proxy alias the chat runs on (sonnet, opus, haiku). Empty means the one
# the prompt file names.
# LLM_MODEL_CHAT=sonnet
# LOG_LEVEL=info

# Web Push, so alerts reach a phone or computer with the tab closed. Make a
# pair with `cd backend && npx web-push generate-vapid-keys`. The private key
# is secret. Empty means alerts show only in the app. VAPID_SUBJECT is a
# contact the push services may use; Safari wants a real mailto: or https:.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
