# Copy to .env. Never commit real values. src/config.ts is the only reader.

# Server
PORT=8091
LOG_LEVEL=info

# Postgres: from compose.local.yaml
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=localdev

# LLM proxy: the llm-proxy container of compose.local.yaml
LLM_PROXY_URL=http://127.0.0.1:4001
# Its Claude login, from `claude setup-token`. Secret. Compose reads it from
# this file and hands it to the container; the api itself never sees it.
CLAUDE_CODE_OAUTH_TOKEN=

# The proxy alias the chat runs on (sonnet, opus, haiku). Default is the one
# the prompt file names.
# LLM_MODEL_CHAT=sonnet
# How many model calls the api may have in flight at once. Keep it at or under
# max_concurrency in proxy/proxy.yaml.
# LLM_MAX_CONCURRENCY=4
